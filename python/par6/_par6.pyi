"""Type surface of the compiled engine binding (`crates/par6-py`).

The extension is the whole engine: wire client, offline preview,
kinematics, collision world and config loader. The typed Python API in
:mod:`par6` is a shim over it and holds no numerics of its own.
Composite results cross as plain dicts (see the crate's `convert.rs`
for the exact keys).
"""

from collections.abc import Awaitable
from typing import Any

NUM_JOINTS: int
MAX_JOG_DURATION_S: float
COLLISION_CLEARANCE_M: float

class RobotWireError(Exception):
    """A structured runtime refusal; ``args`` is the wire 6-tuple
    ``(command_index, code, title, cause, effect, remedy)``."""

def ping_blocking(host: str, port: int, timeout: float = 0.5) -> bool: ...
def make_wire_error(
    code: int, params: dict[str, str] | None = None
) -> tuple[int, int, str, str, str, str]: ...

# ---- pose math (metres, radians; rpy intrinsic XYZ, the wire convention)
def matrix_to_xyzrpy(m: list[float]) -> list[float]: ...
def pose_matrix(xyz: list[float], rpy: list[float]) -> list[float]: ...
def compose_tool_frame(
    origin: list[float], rpy: list[float], offset: list[float]
) -> list[float]: ...
def frame_offset(urdf: str, from_frame: str, to_frame: str) -> list[float]: ...

