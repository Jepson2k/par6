class CoreClient:
    @staticmethod
    def connect(
        host: str | None = None,
        port: int | None = None,
        timeout: float | None = None,
        retries: int | None = None,
        status_transport: str | None = None,
        status_port: int | None = None,
        mcast_group: str | None = None,
        mcast_iface: str | None = None,
        status_unicast_host: str | None = None,
        mtu: int | None = None,
    ) -> Awaitable[CoreClient]: ...
    def endpoint(self) -> tuple[str, int]: ...
    def status_endpoint(self) -> tuple[str, int]: ...
    def close(self) -> None: ...
    def status_seq_gaps(self) -> int: ...
    def latest_status(self) -> dict[str, Any] | None: ...
    def status_after(
        self, last_seq: int, timeout: float
    ) -> Awaitable[dict[str, Any] | None]: ...
    def wait_command(self, index: int, timeout: float) -> Awaitable[bool]: ...
    def command_verdict(self, index: int) -> int | None: ...
    def wait_checkpoint(self, label: str, timeout: float) -> Awaitable[bool]: ...
    def wait_motion(
        self,
        timeout: float,
        settle_window: float,
        speed_threshold: float,
        angle_threshold: float,
        motion_start_timeout: float,
    ) -> Awaitable[bool]: ...
    def is_estop_pressed(self) -> Awaitable[bool]: ...
    def is_robot_stopped(self, threshold: float) -> Awaitable[bool]: ...
    def is_freedrive(self, timeout: float) -> Awaitable[bool]: ...
    # Queries: None when the runtime is unreachable.
    def ping(self) -> Awaitable[bool | None]: ...
    def angles(self) -> Awaitable[list[float] | None]: ...
    def pose(self, frame: int) -> Awaitable[list[float] | None]: ...
    def pose_xyzrpy(self, frame: int) -> Awaitable[list[float] | None]: ...
    def io(self) -> Awaitable[list[int] | None]: ...
    def joint_speeds(self) -> Awaitable[list[float] | None]: ...
    def status_query(self) -> Awaitable[dict[str, Any] | None]: ...
    def tools(self) -> Awaitable[dict[str, Any] | None]: ...
    def queue(self) -> Awaitable[dict[str, Any] | None]: ...
    def activity(self) -> Awaitable[dict[str, Any] | None]: ...
    def loop_stats(self) -> Awaitable[dict[str, Any] | None]: ...
    def reachable(self) -> Awaitable[dict[str, Any] | None]: ...
    def shapes(self) -> Awaitable[dict[str, Any] | None]: ...
    def profile(self) -> Awaitable[str | None]: ...
    def error(self) -> Awaitable[tuple | None]: ...
    def tcp_speed(self) -> Awaitable[float | None]: ...
    def tcp_offset(self) -> Awaitable[list[float] | None]: ...
    def tool_status(self) -> Awaitable[dict[str, Any] | None]: ...
    def is_simulator(self) -> Awaitable[bool | None]: ...
    # SYSTEM: 1 confirmed, 0 unconfirmed; raises RobotWireError on refusal.
    def reset(self) -> Awaitable[int]: ...
    def estop(self) -> Awaitable[int]: ...
    def set_gravity_comp(self, on: bool) -> Awaitable[int]: ...
    def pause(self, on: bool) -> Awaitable[int]: ...
    def stop(self, clear_queue: bool) -> Awaitable[int]: ...
    def write_io(self, port: int, value: int) -> Awaitable[int]: ...
    def simulator(self, on: bool) -> Awaitable[int]: ...
    def select_profile(self, profile: str) -> Awaitable[int]: ...
    def reset_state(self) -> Awaitable[int]: ...
    def connect_hardware(self, port: str) -> Awaitable[int]: ...
    def enter_flashing(self, assertion: str) -> Awaitable[int]: ...
    def exit_flashing(self) -> Awaitable[int]: ...
    def set_pid_gains(
        self,
        node: int,
        kpp: float,
        kpv: float,
        kiv: float,
        kpiq: float,
        kiiq: float,
        kp: float,
        kd: float,
        ilim_ma: float,
        velocity_limit_ticks_s: float,
        voltage_limit_mv: int,
    ) -> Awaitable[int]: ...
    def set_tcp_offset(self, x: float, y: float, z: float) -> Awaitable[int]: ...
    def set_shapes(self, shapes: list[dict[str, Any]]) -> Awaitable[int]: ...
    def set_completion_policy(self, policy: int) -> Awaitable[int]: ...
    def set_recipe(self, name: str) -> Awaitable[int]: ...
    # QUEUED: queue index >= 0, -1 unconfirmed; raises RobotWireError.
    def home(self, calibrate: bool = False) -> Awaitable[int]: ...
    def move_j(
        self,
        angles: list[float],
        duration: float | None,
        speed: float | None,
        accel: float | None,
        blend_radius: float | None,
        rel: bool,
    ) -> Awaitable[int]: ...
    def move_j_pose(
        self,
        pose: list[float],
        duration: float | None,
        speed: float | None,
        accel: float | None,
        blend_radius: float | None,
    ) -> Awaitable[int]: ...
    def move_l(
        self,
        pose: list[float],
        frame: int,
        duration: float | None,
        speed: float | None,
        accel: float | None,
        blend_radius: float | None,
        rel: bool,
    ) -> Awaitable[int]: ...
    def move_c(
        self,
        via: list[float],
        end: list[float],
        frame: int,
        duration: float | None,
        speed: float | None,
        accel: float | None,
        blend_radius: float | None,
        rel: bool = False,
    ) -> Awaitable[int]: ...
    def move_s(
        self,
        waypoints: list[list[float]],
        frame: int,
        duration: float | None,
        speed: float | None,
        accel: float | None,
        rel: bool = False,
    ) -> Awaitable[int]: ...
    def move_p(
        self,
        waypoints: list[list[float]],
        frame: int,
        duration: float | None,
        speed: float | None,
        accel: float | None,
        rel: bool = False,
    ) -> Awaitable[int]: ...
    def select_tool(
        self, tool_name: str, variant_key: str | None
    ) -> Awaitable[int]: ...
    def delay(self, seconds: float) -> Awaitable[int]: ...
    def checkpoint(self, label: str) -> Awaitable[int]: ...
    def tool_action(
        self, tool_key: str, action: str, params: list[Any]
    ) -> Awaitable[int]: ...
    # Fire-and-forget: 1 on send; raises on locally-invalid parameters.
    def servo_j(
        self, angles: list[float], speed: float | None, accel: float | None
    ) -> Awaitable[int]: ...
    def servo_j_pose(
        self, pose: list[float], speed: float | None, accel: float | None
    ) -> Awaitable[int]: ...
    def servo_l(
        self, pose: list[float], speed: float | None, accel: float | None
    ) -> Awaitable[int]: ...
    def jog_j(
        self, speeds: list[float], duration: float, accel: float | None
    ) -> Awaitable[int]: ...
    def jog_l(
        self, velocities: list[float], duration: float, frame: int, accel: float | None
    ) -> Awaitable[int]: ...
    def teleport(
        self, angles: list[float], tool_positions: list[float] | None
    ) -> Awaitable[int]: ...
    def reset_loop_stats(self) -> Awaitable[int]: ...
    def config_info(self) -> Awaitable[dict[str, Any] | None]: ...
    def config_bundle(self) -> Awaitable[dict[str, Any] | None]: ...
    def payload(self) -> Awaitable[dict[str, Any] | None]: ...
    def set_payload(
        self, mass: float, com: list[float], inertia: list[float] | None = None
    ) -> Awaitable[int]: ...
    def identify_payload(
        self,
        config: str | None = None,
        assets: str | None = None,
        package_dir: str | None = None,
        spread: float = 0.5,
        ridge: float = 0.01,
        declare: bool = False,
    ) -> Awaitable[dict[str, Any]]: ...

